#!/bin/zsh
set -eu

project_dir=${0:A:h:h}
page="$project_dir/dist/index.html"

if [[ ${1-} == --help ]]; then
  print 'Usage: textcompare'
  print 'Open the offline, side-by-side text comparison GUI.'
  exit 0
fi
if (( $# )); then
  print -u2 'Usage: textcompare'
  exit 2
fi
exec /usr/bin/open "$page"
